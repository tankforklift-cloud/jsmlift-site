---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact MLIFT" description="Get in touch with MLIFT for forklift pricing, product consultation, dealer inquiries, and after-sales support. Worldwide shipping available.">

<section class="page-header">
  <div class="container">
    <div class="breadcrumb"><a href="/">Home</a> / <span>Contact</span></div>
    <h1>Get in Touch</h1>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-info">
        <h2>We're Here to Help</h2>
        <p class="ci-intro">
          Interested in MLIFT forklifts? Have questions about models, pricing, or shipping?
          Reach out &mdash; we respond within 24 hours.
        </p>

        <div class="ci-item">
          <div class="ci-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <div>
            <div class="ci-label">Phone</div>
            <div class="ci-value">+86 152 9523 7612</div>
          </div>
        </div>

        <div class="ci-item">
          <div class="ci-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <div>
            <div class="ci-label">Email</div>
            <div class="ci-value">tan@jsmlift.com</div>
          </div>
        </div>

        <div class="ci-item">
          <div class="ci-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          </div>
          <div>
            <div class="ci-label">WhatsApp</div>
            <div class="ci-value">+86 152 9523 7612</div>
          </div>
        </div>

        <div class="ci-item">
          <div class="ci-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div>
            <div class="ci-label">Address</div>
            <div class="ci-value">NO.105, KANGNING PEARL, JINGJIANG, JIANGSU, CHINA</div>
          </div>
        </div>
      </div>

      <div class="form-wrap">
        <h3>Send a Message</h3>
        <form action="https://formspree.io/f/FORM_ID" method="POST">
          <div class="form-row">
            <div class="form-g">
              <label for="name">Name *</label>
              <input type="text" id="name" name="name" required placeholder="Your name" />
            </div>
            <div class="form-g">
              <label for="company">Company</label>
              <input type="text" id="company" name="company" placeholder="Your company" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-g">
              <label for="email">Email *</label>
              <input type="email" id="email" name="email" required placeholder="your@email.com" />
            </div>
            <div class="form-g">
              <label for="phone">Phone</label>
              <input type="tel" id="phone" name="phone" placeholder="+XX XXX XXX XXX" />
            </div>
          </div>
          <div class="form-g">
            <label for="product">Interested In</label>
            <select id="product" name="product">
              <option value="">Select a product category...</option>
              <option value="Electric Forklift">Electric Forklift</option>
              <option value="Diesel Forklift">Diesel Forklift</option>
              <option value="LPG Forklift">LPG Forklift</option>
              <option value="Reach Truck">Reach Truck</option>
              <option value="Pallet Truck">Electric Pallet Truck</option>
              <option value="Stacker">Electric Stacker</option>
              <option value="Order Picker">Order Picker</option>
              <option value="Heavy Duty Forklift">Heavy Duty Forklift</option>
              <option value="Other">Other / General Inquiry</option>
            </select>
          </div>
          <div class="form-g">
            <label for="message">Message *</label>
            <textarea id="message" name="message" required placeholder="Tell us about your requirements..."></textarea>
          </div>
          <button type="submit" class="btn-submit">Send Message</button>
        </form>
      </div>
    </div>
  </div>
</section>

</BaseLayout>
