---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact Us" description="Get in touch with MLIFT — professional mini excavator manufacturer. Request quotes, ask questions.">
  
  <div class="page-header">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Home</a> &raquo; Contact Us
      </div>
      <h1>Contact Us</h1>
    </div>
  </div>

  <section class="section" style="padding-top:0;">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:40px;">
        
        <!-- Contact Info -->
        <div>
          <h3 style="font-size:1.3rem;margin-bottom:20px;color:var(--color-primary);">Get In Touch</h3>
          <div style="background:var(--color-bg-alt);padding:24px;border-radius:var(--radius-md);margin-bottom:20px;">
            <p style="margin-bottom:10px;"><i class="fas fa-phone" style="color:var(--color-secondary);width:20px;margin-right:8px;"></i> <strong>Tel:</strong> +86 156 6679 3337</p>
            <p style="margin-bottom:10px;"><i class="fas fa-envelope" style="color:var(--color-secondary);width:20px;margin-right:8px;"></i> <strong>Email:</strong> info@jsmlift.com</p>
            <p style="margin-bottom:10px;"><i class="fab fa-whatsapp" style="color:var(--color-secondary);width:20px;margin-right:8px;"></i> <strong>WhatsApp:</strong> +86 156 6679 3337</p>
            <p><i class="fab fa-weixin" style="color:var(--color-secondary);width:20px;margin-right:8px;"></i> <strong>WeChat:</strong> +86 156 6679 3337</p>
          </div>
          
          <p style="font-size:0.9rem;color:#777;">
            <i class="fas fa-map-marker-alt" style="margin-right:6px;"></i> 
            Jingjiang, Jiangsu Province, China
          </p>
        </div>
        
        <!-- Contact Form -->
        <div>
          <h3 style="font-size:1.3rem;margin-bottom:20px;color:var(--color-primary);">Send a Message</h3>
          <form action="https://formspree.io/f/your-form-id" method="POST">
            <div class="form-group">
              <label for="name">Name</label>
              <input type="text" id="name" name="name" required />
            </div>
            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" required />
            </div>
            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" name="message" rows="5" placeholder="Tell us about your requirements..."></textarea>
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%;">Send</button>
          </form>
        </div>
        
      </div>
    </div>
  </section>

</BaseLayout>
