---
import BaseLayout from '../layouts/BaseLayout.astro';
import { forkliftCategories, heroSlides, stats, testimonials, blogPosts } from '../data/forklifts';
---

<BaseLayout title="MLIFT — Professional Forklift Manufacturer" description="MLIFT delivers world-class forklift solutions — electric, diesel, LPG, heavy-duty, and warehouse equipment. Exporting to 50+ countries with 24/7 support.">

<!-- ===== HERO SLIDER ===== -->
<section class="hero-slider" id="hero">
  <!-- Slide 1 — 使用下载的 Heli Hero 图 -->
  <div class="hero-slide active" data-index="0">
    <img src="/images/hero/hero-1.jpg" alt="MLIFT Forklift" />
    <div class="hero-content">
      <span class="sec-tag" style="display:inline-block;margin-bottom:var(--space-2);color:var(--c-red);font-weight:var(--fw-bold);font-size:0.75rem;letter-spacing:5px">HANDLING &bull; ELECTRIC &bull; LOGISTICS &bull; INTELLIGENT</span>
      <h1 style="font-size:3.8rem;line-height:1.05">{heroSlides[0].title}</h1>
      <p>{heroSlides[0].subtitle}</p>
      <a href={heroSlides[0].link} class="hero-cta">{heroSlides[0].cta}</a>
    </div>
  </div>
  <!-- Slide 2 -->
  <div class="hero-slide" data-index="1" style="background:#B00000">
    <div class="hero-content">
      <span class="sec-tag" style="display:inline-block;margin-bottom:var(--space-2);color:rgba(255,255,255,0.8);font-weight:var(--fw-bold);font-size:0.75rem;letter-spacing:5px">RELIABLE &bull; EFFICIENT &bull; GLOBAL</span>
      <h1 style="font-size:3.8rem;line-height:1.05">{heroSlides[1].title}</h1>
      <p>{heroSlides[1].subtitle}</p>
      <a href={heroSlides[1].link} class="hero-cta">{heroSlides[1].cta}</a>
    </div>
  </div>
  <!-- Slide 3 -->
  <div class="hero-slide" data-index="2" style="background:var(--c-bg-dark)">
    <div class="hero-content">
      <span class="sec-tag" style="display:inline-block;margin-bottom:var(--space-2);color:var(--c-red);font-weight:var(--fw-bold);font-size:0.75rem;letter-spacing:5px">INNOVATION &bull; QUALITY &bull; SERVICE</span>
      <h1 style="font-size:3.8rem;line-height:1.05">{heroSlides[2].title}</h1>
      <p>{heroSlides[2].subtitle}</p>
      <a href={heroSlides[2].link} class="hero-cta">{heroSlides[2].cta}</a>
    </div>
  </div>

  <button class="hero-arrow prev" onclick="changeSlide(-1)" aria-label="Previous">&#10094;</button>
  <button class="hero-arrow next" onclick="changeSlide(1)" aria-label="Next">&#10095;</button>
  <div class="hero-dots">
    <button class="hero-dot active" onclick="goSlide(0)" aria-label="Slide 1"></button>
    <button class="hero-dot" onclick="goSlide(1)" aria-label="Slide 2"></button>
    <button class="hero-dot" onclick="goSlide(2)" aria-label="Slide 3"></button>
  </div>
</section>

<!-- ===== VALUE PROPOSITION ===== -->
<section class="section section-alt">
  <div class="container">
    <div class="vp-grid">
      <div class="vp-card">
        <img src="/images/about/about-slide.jpg" alt="Material Handling Excellence" class="vp-img" />
        <h3>Material Handling Excellence</h3>
        <p>Experience top-tier material handling solutions tailored to your business needs and backed by decades of industry expertise.</p>
      </div>
      <div class="vp-card">
        <img src="/images/products/g3-15-35t-lithium.jpg" alt="Discover 100% Efficiency" class="vp-img" />
        <h3>Discover 100% Efficiency</h3>
        <p>Unlock operational efficiency and reliability with MLIFT, your go-to source for cutting-edge material handling solutions.</p>
      </div>
      <div class="vp-card">
        <img src="/images/products/28-32t-ic-heavy.jpg" alt="Your Partner in Robust Solutions" class="vp-img" />
        <h3>Your Partner in Robust Solutions</h3>
        <p>At MLIFT, we bring you unmatched expertise, innovation, and support to enhance your material handling capabilities.</p>
      </div>
    </div>
  </div>
</section>

<!-- ===== ABOUT US ===== -->
<section class="section">
  <div class="container">
    <div class="about-grid">
      <div>
        <img src="/images/about/about-left.png" alt="MLIFT About" style="width:100%;border-radius:var(--radius-md);box-shadow:var(--shadow-md)" />
      </div>
      <div style="display:flex;flex-direction:column;justify-content:center">
        <h2 style="font-size:2rem;font-weight:var(--fw-extrabold);text-transform:uppercase;margin-bottom:var(--space-2);letter-spacing:-0.5px;color:var(--c-text)">Your Trusted Partner for Robust Material Handling Solutions</h2>
        <p style="font-size:0.95rem;line-height:1.8;color:var(--c-text-secondary);margin-bottom:var(--space-3)">
          JINGJIANG MLIFT MACHINERY CO.,LTD is a professional forklift manufacturer based in Jingjiang, Jiangsu, China.
          We deliver a complete range of material handling equipment — from compact electric pallet trucks to heavy-duty 25-ton diesel forklifts.
        </p>
        <p style="font-size:0.93rem;line-height:1.8;color:var(--c-text-secondary);margin-bottom:var(--space-3)">
          With ISO 9001 and CE certifications, our forklifts meet international quality standards. Every machine undergoes
          rigorous factory testing before shipment. We serve 50+ countries with comprehensive after-sales support, spare parts, and technical service.
        </p>
        <a href="/about" class="btn-red" style="align-self:flex-start">Read More</a>
      </div>
    </div>
  </div>
</section>

<!-- ===== PRODUCT CATEGORIES ===== -->
<section class="section section-alt">
  <div class="container">
    <div class="sec-hdr">
      <span class="sec-tag">Our Products</span>
      <h2>Complete Forklift Range</h2>
      <p>From electric warehouse trucks to heavy-duty diesel forklifts — MLIFT covers every material handling need.</p>
    </div>

    <div class="cat-grid">
      {forkliftCategories.map(cat => (
        <a href={`/products#${cat.id}`} class="cat-card">
          <img src={cat.image || `/images/products/warehouse-forklift.jpg`} alt={cat.name} class="cat-img" />
          <h4>{cat.name}</h4>
        </a>
      ))}
    </div>
    <div style="text-align:center;margin-top:var(--space-5)">
      <a href="/products" class="btn-red">View All Products</a>
    </div>
  </div>
</section>

<!-- ===== CORE SERVICES ===== -->
<section class="section">
  <div class="container">
    <div class="sec-hdr">
      <span class="sec-tag">HANDLING &bull; ELECTRIC &bull; LOGISTICS &bull; INTELLIGENT</span>
      <h2>Core Services</h2>
      <p>Comprehensive support covering the full lifecycle of your forklift fleet.</p>
    </div>
    <div class="svc-grid">
      <div class="svc-card">
        <img src="/images/services/safety-training.jpg" alt="Safety Training" style="width:100%;border-radius:var(--radius-md);margin-bottom:var(--space-3);aspect-ratio:16/10;object-fit:cover" />
        <h3>Safety / Training</h3>
        <p>Operator training programs, safety certification, and on-site instruction to ensure safe, compliant forklift operation.</p>
        <a href="/support" class="svc-link">Read More</a>
      </div>
      <div class="svc-card">
        <img src="/images/services/inspection-maintenance.jpg" alt="Inspection Maintenance" style="width:100%;border-radius:var(--radius-md);margin-bottom:var(--space-3);aspect-ratio:16/10;object-fit:cover" />
        <h3>Inspection / Maintenance</h3>
        <p>Preventive maintenance schedules, thorough inspections, and fleet health monitoring to maximize uptime.</p>
        <a href="/support" class="svc-link">Read More</a>
      </div>
      <div class="svc-card">
        <img src="/images/services/sales-network.jpg" alt="Sales Network" style="width:100%;border-radius:var(--radius-md);margin-bottom:var(--space-3);aspect-ratio:16/10;object-fit:cover" />
        <h3>Sales Network</h3>
        <p>Global distribution network. Spare parts available worldwide. Contact us for dealer inquiries or direct purchase.</p>
        <a href="/support" class="svc-link">Read More</a>
      </div>
    </div>
  </div>
</section>

<!-- ===== TESTIMONIALS ===== -->
<section class="section section-alt">
  <div class="container">
    <div class="sec-hdr">
      <span class="sec-tag">What Clients Say</span>
      <h2>Trusted Worldwide</h2>
      <p>MLIFT forklifts power operations across 50+ countries. Here's what our customers say.</p>
    </div>

    <div class="testimonial-grid">
      {testimonials.map(t => (
        <div class="testimonial-card">
          <p>"{t.quote}"</p>
          <div style="display:flex;align-items:center;gap:12px;margin-top:var(--space-2)">
            <img src="/images/testimonial/avatar.webp" alt={t.author} style="width:48px;height:48px;border-radius:50%;object-fit:cover" />
            <div>
              <div class="tc-author">{t.author}</div>
              <div class="tc-role">{t.company}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ===== STATS ===== -->
<section class="section">
  <div class="container">
    <div class="stats-row">
      {stats.map(s => (
        <div class="stat-item">
          <div class="stat-num">{s.value}</div>
          <div class="stat-label">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ===== MISSION / VISION / HISTORY ===== -->
<section class="section section-alt">
  <div class="container">
    <div class="sec-hdr">
      <h2>Who We Are</h2>
      <p>Driven by innovation, built on quality. MLIFT's commitment to material handling excellence.</p>
    </div>
    <div class="tabs-wrap">
      <div class="tabs-nav" id="tabsNav">
        <button class="tab-btn active" data-tab="mission">Our Mission</button>
        <button class="tab-btn" data-tab="vision">Our Vision</button>
        <button class="tab-btn" data-tab="history">Our History</button>
      </div>
      <div class="tab-panel active" id="mission">
        <h3>Delivering Reliable Material Handling Solutions</h3>
        <p>Our mission is to provide professional-grade forklift equipment at competitive prices. Every MLIFT forklift is engineered to perform reliably in real-world conditions — from the busy ports of Southeast Asia to the demanding warehouses of the Middle East. We believe every business deserves quality material handling equipment that works as hard as they do.</p>
      </div>
      <div class="tab-panel" id="vision">
        <h3>Global Reach, Local Support</h3>
        <p>We envision MLIFT as a globally recognized brand in material handling — trusted by businesses on every continent. Through continuous engineering refinement, strategic partnerships, and unwavering customer commitment, we aim to become the preferred choice for forklift solutions worldwide.</p>
      </div>
      <div class="tab-panel" id="history">
        <h3>Rooted in Manufacturing Excellence</h3>
        <p>JINGJIANG MLIFT MACHINERY CO.,LTD was founded with a clear purpose: to build industrial equipment that meets international quality standards at competitive prices. Our team brings decades of manufacturing experience, and every forklift represents the culmination of rigorous engineering, testing, and customer-driven refinement.</p>
      </div>
    </div>
  </div>
</section>

<!-- ===== PARTNERS ===== -->
<section class="section">
  <div class="container">
    <div class="sec-hdr">
      <span class="sec-tag">Trusted By</span>
      <h2>Our Partners</h2>
      <p>MLIFT is proud to work with leading enterprises and distributors worldwide.</p>
    </div>
    <div class="partner-grid">
      <div class="partner-item"><img src="/images/clients/client-1.png" alt="Partner 1" style="max-width:120px;filter:none" /></div>
      <div class="partner-item"><img src="/images/clients/client-2.png" alt="Partner 2" style="max-width:120px;filter:none" /></div>
      <div class="partner-item"><img src="/images/clients/client-3.png" alt="Partner 3" style="max-width:120px;filter:none" /></div>
      <div class="partner-item"><img src="/images/clients/client-4.png" alt="Partner 4" style="max-width:120px;filter:none" /></div>
      <div class="partner-item"><img src="/images/clients/client-5.png" alt="Partner 5" style="max-width:120px;filter:none" /></div>
    </div>
  </div>
</section>

<!-- ===== BLOG ===== -->
<section class="section section-alt">
  <div class="container">
    <div class="sec-hdr">
      <span class="sec-tag">Latest Updates</span>
      <h2>What's Going On?</h2>
      <p>Stay informed about MLIFT product updates, industry insights, and material handling news.</p>
    </div>
    <div class="blog-grid">
      {blogPosts.map((post, i) => {
          const blogImages = [
            '/images/products/g3-15-35t-lithium.jpg',
            '/images/products/18ton-container-handler.jpg',
            '/images/products/g2-16-2t-warehouse.jpg',
          ];
          return (
        <div class="blog-card">
          <div class="bc-img">
            <img src={blogImages[i]} alt={post.title} />
          </div>
          <div class="bc-body">
            <div class="bc-date">{post.date}</div>
            <h4>{post.title}</h4>
            <p>{post.excerpt}</p>
            <a href="/blog" class="bc-link">Read More</a>
          </div>
        </div>
          );
        })}
    </div>
    <div style="text-align:center;margin-top:var(--space-5)">
      <a href="/blog" class="btn-red">View All Articles</a>
    </div>
  </div>
</section>

<!-- ===== DEALER CTA ===== -->
<section class="section">
  <div class="container">
    <div class="dealer-cta">
      <h3>Become an MLIFT Dealer</h3>
      <p>Interested in becoming an MLIFT dealer or distributor in your region? We are actively expanding our global sales network and seeking qualified partners.</p>
      <a href="/contact" class="btn-red">Contact Us Today</a>
    </div>
  </div>
</section>

<!-- ===== FINAL CTA ===== -->
<section class="cta-section">
  <div class="container">
    <h2>Connect with MLIFT</h2>
    <p>Tailored material handling solutions for your business. Get in touch for a quote, product demo, or dealer inquiry.</p>
    <a href="/contact" class="hero-cta">Contact Us</a>
  </div>
</section>

</BaseLayout>

<script is:inline>
  // Hero slider
  let current = 0;
  const total = 3;
  function showSlide(n) {
    document.querySelectorAll('.hero-slide').forEach((s,i) => s.classList.toggle('active', i===n));
    document.querySelectorAll('.hero-dot').forEach((d,i) => d.classList.toggle('active', i===n));
    current = n;
  }
  function changeSlide(dir) {
    showSlide((current + dir + total) % total);
  }
  function goSlide(n) { showSlide(n); }
  setInterval(() => changeSlide(1), 6000);

  // Mission/Vision/History tabs
  const tabBtns = document.querySelectorAll('.tab-btn');
  const tabPanels = document.querySelectorAll('.tab-panel');
  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = btn.dataset.tab;
      tabBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      tabPanels.forEach(p => p.classList.remove('active'));
      document.getElementById(tab)?.classList.add('active');
    });
  });
</script>
