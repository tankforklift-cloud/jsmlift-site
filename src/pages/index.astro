---
import BaseLayout from '../layouts/BaseLayout.astro';
import { excavators } from '../data/excavators';
import { categories } from '../data/products';

const heroSlides = [
  { img: '/images/hero/hs-excavator-work.jpg', tag: 'Mini Excavators', title: 'Compact Power for Every Jobsite', desc: 'MLIFT mini excavators &mdash; engineered for reliability, built to perform. 1.2 to 4.2 ton range, worldwide shipping.', cta: 'View Excavators', link: '/excavators' },
  { img: '/images/hero/hs-excavator-line.jpg', tag: 'Forklift Parts', title: 'OEM Quality Replacement Parts', desc: '13 categories, 70+ products. Air filters, hydraulics, brakes, engine parts &mdash; ready to ship.', cta: 'Browse Parts', link: '/forklift-parts' },
  { img: '/images/hero/hs-factory.jpg', tag: 'MLIFT', title: 'Your Trusted Machinery Partner', desc: 'Direct from our China factory. Competitive pricing, fast delivery. Let&rsquo;s work together.', cta: 'Contact Us', link: '/contact' },
];
---

<BaseLayout title="Home">
  <!-- Hero Slider -->
  <section class="hero-slider" id="heroSlider">
    {heroSlides.map((slide, i) => (
      <div class={`hero-slide${i === 0 ? ' active' : ''}`} data-index={i}>
        <img src={slide.img} alt={slide.tag} />
        <div class="hero-content">
          <span class="hero-tag">{slide.tag}</span>
          <h1 set:html={slide.title} />
          <p set:html={slide.desc} />
          <a href={slide.link} class="hero-cta">{slide.cta} &rarr;</a>
        </div>
      </div>
    ))}
    <button class="hero-arrow prev" id="heroPrev">&#10094;</button>
    <button class="hero-arrow next" id="heroNext">&#10095;</button>
    <div class="hero-dots" id="heroDots">
      {heroSlides.map((_, i) => (
        <button class={`hero-dot${i === 0 ? ' active' : ''}`} data-dot={i}></button>
      ))}
    </div>
  </section>

  <!-- Mini Excavators -->
  <section class="section">
    <div class="container">
      <div class="sec-hdr">
        <h2>Mini Excavators</h2>
        <p>Compact, powerful, and built to last. Our mini excavators deliver exceptional performance in tight spaces &mdash; from landscaping to construction.</p>
      </div>
      <div class="card-grid">
        {excavators.slice(0, 4).map(ex => (
          <a href={`/product/${ex.slug}`} class="card">
            <div class="card-img">
              <img src={ex.images[0]} alt={ex.name} loading="lazy" />
            </div>
            <div class="card-body">
              {ex.badge && <span class="card-badge yellow">{ex.badge}</span>}
              <h3>{ex.name}</h3>
              <p>{ex.description.slice(0, 90)}&hellip;</p>
              <span class="card-link">Learn more</span>
            </div>
          </a>
        ))}
      </div>
      <div style="text-align:center; margin-top:var(--space-4);">
        <a href="/excavators" class="btn btn-yellow">View All Excavators &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Forklift Parts -->
  <section class="section section-gray">
    <div class="container">
      <div class="sec-hdr">
        <h2>Forklift Parts</h2>
        <p>OEM-quality replacement parts across 13 categories. Engine, hydraulic, brake, electrical &mdash; everything your forklift needs.</p>
      </div>
      <div class="card-grid">
        {categories.slice(0, 6).map(cat => (
          <a href="/forklift-parts" class="card">
            <div class="card-img">
              <img src={cat.image} alt={cat.name} loading="lazy" />
            </div>
            <div class="card-body">
              <h3>{cat.name}</h3>
              <p>{cat.description}</p>
              <span class="card-link">Browse</span>
            </div>
          </a>
        ))}
      </div>
      <div style="text-align:center; margin-top:var(--space-4);">
        <a href="/forklift-parts" class="btn btn-outline">All Forklift Parts &rarr;</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container">
      <h2>Need a Quote?</h2>
      <p>Whether you're looking for a mini excavator or forklift replacement parts, we're here to help with competitive pricing and fast response.</p>
      <a href="/contact" class="btn btn-yellow btn-lg">Get In Touch &rarr;</a>
    </div>
  </section>
</BaseLayout>

<script>
  const slides = document.querySelectorAll('.hero-slide');
  const dots = document.querySelectorAll('.hero-dot');
  let currentSlide = 0;
  let autoPlay: number;

  function showSlide(index: number) {
    slides.forEach(s => s.classList.remove('active'));
    dots.forEach(d => d.classList.remove('active'));
    slides[index].classList.add('active');
    dots[index].classList.add('active');
    currentSlide = index;
  }

  document.getElementById('heroPrev')?.addEventListener('click', () => {
    showSlide((currentSlide - 1 + slides.length) % slides.length);
  });
  document.getElementById('heroNext')?.addEventListener('click', () => {
    showSlide((currentSlide + 1) % slides.length);
  });
  dots.forEach(dot => {
    dot.addEventListener('click', () => {
      showSlide(parseInt(dot.dataset.dot || '0'));
    });
  });
  autoPlay = setInterval(() => showSlide((currentSlide + 1) % slides.length), 5000);
</script>
