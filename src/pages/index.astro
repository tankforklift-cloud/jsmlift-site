---
import BaseLayout from '../layouts/BaseLayout.astro';
import { m16 } from '../data/m16';
---

<BaseLayout title="MLIFT M16 — Professional Round Bale Wrapper" description="MLIFT M16 round bale wrapper: transport, wrap, and stack with one machine. Compact, robust design. Bale diameter 0.90–1.60 m. Get a quote today.">

<!-- ===== HERO ===== -->
<section class="hero-slider" id="hero">
  {
    m16.heroImages.map((img, i) => (
      <div class={`hero-slide ${i === 0 ? 'active' : ''}`} data-index={i}>
        <img src={img.src} alt={img.alt} />
        <div class="hero-content">
          <span class="hero-tag">{i === 0 ? 'New Release' : i === 1 ? 'Field Proven' : 'Built to Last'}</span>
          <h1>{i === 0 ? 'MLIFT M16' : i === 1 ? 'One Machine. Every Job.' : 'Engineered for Farmers'}</h1>
          <p>{i === 0 ? 'The round bale wrapper that does it all — transport, wrap, and stack with a single machine. Compact. Robust. Reliable.' : i === 1 ? 'From pickup to wrapped-and-stacked. The M16 handles every step with precision and power, saving you time and fuel.' : 'Built with the same commitment to quality that defines German agricultural engineering. Priced for the working farmer.'}</p>
          {i === 0 && <a href="#specs" class="hero-cta">Explore Specs →</a>}
          {i === 1 && <a href="/contact" class="hero-cta">Request a Quote →</a>}
          {i === 2 && <a href="/about" class="hero-cta">About MLIFT →</a>}
        </div>
      </div>
    ))
  }
  <!-- Controls -->
  <button class="hero-arrow prev" onclick="changeSlide(-1)" aria-label="Previous">&#10094;</button>
  <button class="hero-arrow next" onclick="changeSlide(1)" aria-label="Next">&#10095;</button>
  <div class="hero-dots">
    {m16.heroImages.map((_, i) => (
      <button class={`hero-dot ${i === 0 ? 'active' : ''}`} onclick={`goSlide(${i})`} aria-label={`Slide ${i + 1}`}></button>
    ))}
  </div>
</section>

<!-- ===== SPEC HIGHLIGHT STRIP ===== -->
<section class="section" id="specs" style="padding-bottom:0">
  <div class="container">
    <div class="spec-strip">
      {m16.keySpecs.map(s => (
        <div class="spec-item">
          <div class="spec-icon">{s.icon}</div>
          <div class="spec-value">{s.value}</div>
          <div class="spec-label">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ===== PRODUCT OVERVIEW ===== -->
<section class="section">
  <div class="container">
    <div class="sec-hdr">
      <div class="accent-bar"></div>
      <h2>MLIFT M16 — Round Bale Wrapper</h2>
      <p>The M16 combines transport, wrapping, and stacking into one compact, robust machine. Two rollers actuated in series ensure even bale rotation for consistent film coverage — every time.</p>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-5);align-items:center;max-width:1000px;margin:0 auto">
      <div style="aspect-ratio:16/10;overflow:hidden;background:var(--c-gray-100)">
        <img src="/images/m16/m16/m16-main.jpg" alt="MLIFT M16 Round Bale Wrapper" style="width:100%;height:100%;object-fit:cover" />
      </div>
      <div>
        <h3 style="font-size:1.5rem;font-weight:var(--fw-extrabold);margin-bottom:var(--space-2);letter-spacing:-0.3px">Why the M16?</h3>
        <p style="font-size:0.93rem;line-height:1.8;color:var(--c-text-muted);margin-bottom:var(--space-2)">
          Ultra-compact design at just 985 kg, yet handles bales up to 1,200 kg. Cat. II/III hitch fits virtually any tractor. Front or rear mounting gives you total flexibility.
        </p>
        <ul style="list-style:none;padding:0;margin:0 0 var(--space-3)">
          <li style="padding:6px 0;padding-left:22px;position:relative;font-size:0.9rem;color:var(--c-text-muted)"><span style="position:absolute;left:0;top:6px;font-weight:bold;color:var(--c-gold)">▸</span> 750 mm film roll with 3-patent pre-stretcher</li>
          <li style="padding:6px 0;padding-left:22px;position:relative;font-size:0.9rem;color:var(--c-text-muted)"><span style="position:absolute;left:0;top:6px;font-weight:bold;color:var(--c-gold)">▸</span> Load Sensing compatible — works with any tractor</li>
          <li style="padding:6px 0;padding-left:22px;position:relative;font-size:0.9rem;color:var(--c-text-muted)"><span style="position:absolute;left:0;top:6px;font-weight:bold;color:var(--c-gold)">▸</span> Radio remote + electronic joystick control</li>
          <li style="padding:6px 0;padding-left:22px;position:relative;font-size:0.9rem;color:var(--c-text-muted)"><span style="position:absolute;left:0;top:6px;font-weight:bold;color:var(--c-gold)">▸</span> Standard LED work lights for low-light operation</li>
        </ul>
        <a href="/m16" class="btn btn-gold btn-lg">Full Specifications →</a>
      </div>
    </div>
  </div>
</section>

<!-- ===== KEY FEATURES ===== -->
<section class="section section-gray">
  <div class="container">
    <div class="sec-hdr">
      <div class="accent-bar"></div>
      <h2>Built for the Job</h2>
      <p>Every component of the M16 is engineered for reliability in real farming conditions.</p>
    </div>
    {
      m16.features.slice(0, 4).map((feat, i) => (
        <div class="feat-card">
          <div class="feat-card-img">
            {feat.image && <img src={`/images/m16/m16/${feat.image}`} alt={feat.title} loading={i > 1 ? 'lazy' : 'eager'} />}
          </div>
          <div class="feat-card-text">
            <h3>{feat.title}</h3>
            <p>{feat.desc}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<!-- ===== MORE FEATURES ===== -->
<section class="section">
  <div class="container">
    <div class="sec-hdr">
      <div class="accent-bar"></div>
      <h2>Smart Details</h2>
      <p>Features that make a real difference in daily operation.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:var(--space-3)">
      {
        m16.features.slice(4).map((feat, i) => (
          <div class="card" style="padding:var(--space-3);text-align:center">
            {feat.image && (
              <div style="aspect-ratio:16/10;overflow:hidden;background:var(--c-gray-100);margin-bottom:var(--space-2)">
                <img src={`/images/m16/m16/${feat.image}`} alt={feat.title} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
              </div>
            )}
            <h3 style="font-size:0.95rem;font-weight:var(--fw-bold);margin-bottom:6px">{feat.title}</h3>
            <p style="font-size:0.82rem;color:var(--c-text-muted);line-height:1.6">{feat.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- ===== CTA ===== -->
<section class="cta-section">
  <div class="container">
    <h2>Ready to wrap smarter?</h2>
    <p>The MLIFT M16 delivers German-engineering quality at a price that makes sense for your operation. Get in touch for a quote.</p>
    <a href="/contact" class="btn btn-gold btn-lg">Request a Quote →</a>
  </div>
</section>

</BaseLayout>

<script is:inline>
  let current = 0;
  const total = {m16.heroImages.length};
  function showSlide(n: number) {
    document.querySelectorAll('.hero-slide').forEach((s,i) => s.classList.toggle('active', i===n));
    document.querySelectorAll('.hero-dot').forEach((d,i) => d.classList.toggle('active', i===n));
    current = n;
  }
  function changeSlide(dir: number) {
    showSlide((current + dir + total) % total);
  }
  function goSlide(n: number) { showSlide(n); }
  // auto-advance every 6 seconds
  setInterval(() => changeSlide(1), 6000);
</script>
