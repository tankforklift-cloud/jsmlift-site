---
import BaseLayout from '../layouts/BaseLayout.astro';
import { excavators } from '../data/excavators';
import { categories } from '../data/products';

const heroSlides = [
  { img: '/images/hero/hs-excavator-work.jpg', tag: 'Mini Excavators', title: 'Compact Power for Your Jobsite', desc: 'MLIFT mini excavators — engineered for reliability, shipped worldwide.' },
  { img: '/images/hero/hs-excavator-line.jpg', tag: 'Forklift Parts', title: 'OEM Quality Forklift Parts', desc: '13 categories, 70+ products. Hangcha & Heli compatible parts, ready to ship.' },
  { img: '/images/hero/hs-factory.jpg', tag: 'MLIFT', title: 'Your Trusted Machinery Partner', desc: 'Direct from our China factory. Competitive pricing, fast delivery.' },
];
---

<BaseLayout title="Home">
  <!-- Hero Slider -->
  <section class="hero-slider" id="heroSlider">
    {heroSlides.map((slide, i) => (
      <div class={`hero-slide${i === 0 ? ' active' : ''}`} data-index={i}>
        <img src={slide.img} alt={slide.tag} />
        <div class="hero-content">
          <span class="hero-tag">{slide.tag}</span>
          <h1>{slide.title}</h1>
          <p>{slide.desc}</p>
          <a href={i === 0 ? '/excavators' : i === 1 ? '/forklift-parts' : '/contact'} class="hero-cta">
            {i === 0 ? 'View Excavators' : i === 1 ? 'Browse Parts' : 'Contact Us'} <i class="fas fa-arrow-right"></i>
          </a>
        </div>
      </div>
    ))}
    <button class="hero-arrow prev" id="heroPrev"><i class="fas fa-chevron-left"></i></button>
    <button class="hero-arrow next" id="heroNext"><i class="fas fa-chevron-right"></i></button>
    <div class="hero-controls" id="heroDots">
      {heroSlides.map((_, i) => (
        <button class={`hero-dot${i === 0 ? ' active' : ''}`} data-dot={i}></button>
      ))}
    </div>
  </section>

  <!-- Mini Excavators Product Line -->
  <section class="product-lines-section">
    <div class="container">
      <div class="section-header">
        <h2>Mini Excavators</h2>
        <p>Compact, powerful, and built to last. Our mini excavators are engineered for performance in tight spaces.</p>
      </div>
      <div class="product-line-grid">
        {excavators.slice(0, 4).map(ex => (
          <a href={`/product/${ex.slug}`} class="product-line-card">
            <div class="card-image">
              <img src={ex.images[0]} alt={ex.name} loading="lazy" />
            </div>
            <div class="card-body">
              {ex.badge && <span class="card-badge">{ex.badge}</span>}
              <h3>{ex.name}</h3>
              <p>{ex.description.slice(0, 100)}...</p>
              <span class="card-link">View Details</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Forklift Parts Section -->
  <section class="section" style="background: var(--color-white);">
    <div class="container">
      <div class="section-header">
        <h2>Forklift Parts</h2>
        <p>OEM-quality replacement parts for Hangcha & Heli forklifts. 13 categories covering all major systems.</p>
      </div>
      <div class="product-line-grid">
        {categories.slice(0, 6).map(cat => (
          <a href="/forklift-parts" class="product-line-card">
            <div class="card-image">
              <img src={cat.image} alt={cat.name} loading="lazy" />
            </div>
            <div class="card-body">
              <h3>{cat.name}</h3>
              <p>{cat.description}</p>
              <span class="card-link">Browse {cat.name}</span>
            </div>
          </a>
        ))}
      </div>
      <div style="text-align:center; margin-top:32px;">
        <a href="/forklift-parts" class="hero-cta">View All Forklift Parts <i class="fas fa-arrow-right"></i></a>
      </div>
    </div>
  </section>

  <!-- Dark CTA -->
  <section class="cta-dark">
    <div class="container">
      <h2>Need a Quote?</h2>
      <p>Whether you're looking for a mini excavator or forklift replacement parts, we're here to help with competitive pricing and fast response.</p>
      <a href="/contact" class="btn-yellow">Get In Touch <i class="fas fa-envelope"></i></a>
    </div>
  </section>
</BaseLayout>

<script>
  // Hero Slider
  const slides = document.querySelectorAll('.hero-slide');
  const dots = document.querySelectorAll('.hero-dot');
  let currentSlide = 0;
  let autoPlay: number;

  function showSlide(index: number) {
    slides.forEach(s => s.classList.remove('active'));
    dots.forEach(d => d.classList.remove('active'));
    slides[index].classList.add('active');
    dots[index].classList.add('active');
    currentSlide = index;
  }

  document.getElementById('heroPrev')?.addEventListener('click', () => {
    showSlide((currentSlide - 1 + slides.length) % slides.length);
  });
  document.getElementById('heroNext')?.addEventListener('click', () => {
    showSlide((currentSlide + 1) % slides.length);
  });
  dots.forEach(dot => {
    dot.addEventListener('click', () => {
      showSlide(parseInt(dot.dataset.dot || '0'));
    });
  });

  function startAutoPlay() {
    autoPlay = setInterval(() => {
      showSlide((currentSlide + 1) % slides.length);
    }, 5000);
  }
  startAutoPlay();
</script>
