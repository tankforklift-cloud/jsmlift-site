---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Blog" description="MLIFT blog: product updates, industry insights, and agricultural machinery news. Stay informed about round bale wrapping technology.">

<section class="page-header">
  <div class="container">
    <div class="breadcrumb"><a href="/">Home</a> / <span>Blog</span></div>
    <h1>Blog</h1>
    <p style="opacity:0.8;font-size:1.05rem;margin-top:4px">Product updates, industry insights, and agricultural machinery news.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="blog-grid">
      <div class="blog-card">
        <div class="bc-img">
          <img src="/images/m16/m16/m16-field-2.jpg" alt="M16 field operation" loading="lazy" />
        </div>
        <div class="bc-body">
          <div class="bc-date">June 2026</div>
          <h4>MLIFT Wins First International Order — LS Cable System Mexico</h4>
          <p>MLIFT M16 round bale wrappers selected by LS Cable &amp; System Mexico for their Queretaro facility. A milestone for our global expansion.</p>
          <a href="#" class="bc-link">Read More</a>
        </div>
      </div>
      <div class="blog-card">
        <div class="bc-img">
          <img src="/images/m16/m16/m16-wrapping.jpg" alt="M16 wrapping" loading="lazy" />
        </div>
        <div class="bc-body">
          <div class="bc-date">May 2026</div>
          <h4>M16 Receives Full Product Certification — Ready for Global Export</h4>
          <p>Complete documentation package now available for international customers including CE compliance certification.</p>
          <a href="#" class="bc-link">Read More</a>
        </div>
      </div>
      <div class="blog-card">
        <div class="bc-img">
          <img src="/images/m16/m16/m16-arm.jpg" alt="M16 wrapping arm" loading="lazy" />
        </div>
        <div class="bc-body">
          <div class="bc-date">April 2026</div>
          <h4>How to Choose the Right Round Bale Wrapper for Your Farm</h4>
          <p>A practical guide to evaluating bale diameter, hydraulic requirements, and film wrapping systems.</p>
          <a href="#" class="bc-link">Read More</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section-dark">
  <div class="container" style="max-width:800px">
    <div class="sec-hdr">
      <span class="sec-tag">Coming Soon</span>
      <h2>More Articles</h2>
      <p>We're building a knowledge base of agricultural machinery insights. Check back for new articles on baling, wrapping, and farm equipment.</p>
    </div>
    <div style="text-align:center">
      <a href="/contact" class="btn-red">Subscribe for Updates</a>
    </div>
  </div>
</section>

</BaseLayout>
