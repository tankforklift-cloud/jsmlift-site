---
import BaseLayout from '../layouts/BaseLayout.astro';
import { blogPosts } from '../data/forklifts';
---

<BaseLayout title="Blog" description="MLIFT blog: forklift industry insights, product updates, material handling trends, and maintenance tips. Stay informed about the latest in warehouse equipment.">

<section class="page-header">
  <div class="container">
    <div class="breadcrumb"><a href="/">Home</a> / <span>Blog</span></div>
    <h1>Blog</h1>
    <p style="opacity:0.8;font-size:1.05rem;margin-top:4px">Industry insights, product updates, and material handling expertise.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="blog-grid">
      {blogPosts.map(post => (
        <div class="blog-card">
          <div class="bc-img" style="background:linear-gradient(135deg, var(--c-dark-3), var(--c-dark-4));display:flex;align-items:center;justify-content:center;min-height:200px">
            <span style="font-size:2.5rem">📰</span>
          </div>
          <div class="bc-body">
            <div class="bc-date">{post.date}</div>
            <h4>{post.title}</h4>
            <p>{post.excerpt}</p>
            <a href="#" class="bc-link">Read More</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section section-dark">
  <div class="container" style="max-width:800px">
    <div class="sec-hdr">
      <span class="sec-tag">Coming Soon</span>
      <h2>More Insights</h2>
      <p>We're building a knowledge base of material handling expertise. Check back for articles on forklift selection, fleet management, battery technology, and warehouse optimization.</p>
    </div>
    <div style="text-align:center">
      <a href="/contact" class="btn-red">Subscribe for Updates</a>
    </div>
  </div>
</section>

</BaseLayout>
