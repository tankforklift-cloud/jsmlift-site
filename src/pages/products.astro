---
import BaseLayout from '../layouts/BaseLayout.astro';
import { forkliftCategories } from '../data/forklifts';
---

<BaseLayout title="Products — MLIFT Forklifts & Material Handling Equipment" description="Explore MLIFT's complete range of forklifts: Electric Lithium-Ion, IC Forklifts, Lead-Acid, Warehouse Equipment, Heavy Forklifts, Tractors, Wheel Loaders, Special Equipment, Parts & Attachments.">
  <section class="page-hero" style="padding:160px 0 80px">
    <div class="container">
      <div class="sec-tag">OUR PRODUCTS</div>
      <h1 style="font-size:clamp(2.4rem,5vw,3.6rem);font-weight:var(--fw-extrabold);text-transform:uppercase;margin-bottom:var(--space-3);color:var(--c-text)">Forklifts & Material Handling Equipment</h1>
      <p style="font-size:1.1rem;color:var(--c-text-secondary);max-width:640px;line-height:1.7">
        From compact warehouse stackers to heavy-duty container handlers, MLIFT delivers reliable material handling solutions engineered for performance and durability.
      </p>
    </div>
  </section>

  <!-- Category grid (home-page style) -->
  <section class="section-alt" style="padding:var(--space-6) 0">
    <div class="container">
      <div class="sec-tag">PRODUCT CATEGORIES</div>
      <h2 class="sec-hdr" style="margin-bottom:var(--space-5)">Explore Our Range</h2>
      <div class="cat-grid">
        {forkliftCategories.map(cat => (
          <a href={`#${cat.id}`} class="cat-card">
            <img src={cat.image} alt={cat.name} class="cat-img" loading="lazy" />
            <h4>{cat.name}</h4>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Product listings by category -->
  {forkliftCategories.map(cat => (
    <section id={cat.id} class="prod-cat-section" style="padding:var(--space-6) 0">
      <div class="container">
        <div style="display:flex;align-items:center;gap:var(--space-3);margin-bottom:var(--space-5)">
          <div style="width:4px;height:40px;background:var(--c-red);border-radius:2px"></div>
          <div>
            <h2 style="font-size:clamp(1.6rem,3vw,2rem);font-weight:var(--fw-extrabold);text-transform:uppercase;margin:0;color:var(--c-text)">{cat.name}</h2>
            <p style="margin:4px 0 0;font-size:0.95rem;color:var(--c-text-secondary);max-width:600px">{cat.description}</p>
          </div>
        </div>

        <div class="product-grid">
          {cat.models.map(model => (
            <a href={`/products/${cat.id}/${model.id}`} class="product-card">
              <div class="product-img-wrap">
                <img src={model.image} alt={model.name} loading="lazy" />
              </div>
              <div class="product-info">
                <h4>{model.name}</h4>
                {model.capacity && <span class="product-cap">Capacity: {model.capacity}</span>}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-4);
  }
  .product-card {
    background: var(--c-bg);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .product-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
    border-color: var(--c-red);
  }
  .product-img-wrap {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--c-bg-alt);
  }
  .product-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .product-card:hover .product-img-wrap img {
    transform: scale(1.05);
  }
  .product-info {
    padding: var(--space-3);
  }
  .product-info h4 {
    font-size: 0.95rem;
    font-weight: var(--fw-bold);
    color: var(--c-text);
    margin: 0 0 var(--space-1);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .product-cap {
    font-size: 0.8rem;
    color: var(--c-red);
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .prod-cat-section:nth-child(even) {
    background: var(--c-bg-alt);
  }
</style>
