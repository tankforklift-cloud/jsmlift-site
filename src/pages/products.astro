---
import BaseLayout from '../layouts/BaseLayout.astro';
import { excavators } from '../data/excavators';
---

<BaseLayout title="Products" description="MLIFT Mini Hydraulic Excavators — HS12-6, HS18, HS20, HS45 models for worldwide delivery.">
  
  <!-- Page Header -->
  <div class="page-header">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Home</a> &raquo; Products
      </div>
      <h1>Products</h1>
    </div>
  </div>

  <!-- Product List -->
  <section class="section" style="padding-top:0;">
    <div class="container">
      {excavators.map((exc) => (
        <div class="product-list-item">
          <div class="img-wrap">
            <img src={exc.images[0]} alt={exc.name} loading="lazy" />
            {exc.badge && <span class="badge">{exc.badge}</span>}
          </div>
          <div class="info">
            <h3><a href={`/product/${exc.slug}`}>{exc.name}</a></h3>
            <p class="desc">{exc.description.substring(0, 200)}...</p>
            <div class="specs-row">
              <span><strong>Weight:</strong> {exc.weight}</span>
              <span><strong>Engine:</strong> {exc.engine}</span>
              <span><strong>Power:</strong> {exc.power}</span>
              <span><strong>Bucket:</strong> {exc.bucket}</span>
            </div>
            <div class="actions">
              <a href={`/product/${exc.slug}`} class="btn btn-primary btn-sm">View Details</a>
              <a href="/contact" class="btn btn-outline btn-sm">Send Inquiry</a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

</BaseLayout>
