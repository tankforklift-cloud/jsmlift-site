---
import BaseLayout from '../layouts/BaseLayout.astro';
import { forkliftCategories } from '../data/forklifts';

// Map category id to image
const catImages = {
  'electric-forklifts': '/images/products/electric-forklift.jpg',
  'diesel-forklifts': '/images/products/ic-forklift.jpg',
  'lpg-forklifts': '/images/products/ic-forklift.jpg',
  'heavy-forklifts': '/images/products/ic-forklift.jpg',
  'reach-trucks': '/images/products/warehouse-forklift.jpg',
  'stackers': '/images/products/warehouse-forklift.jpg',
  'pallet-trucks': '/images/products/warehouse-forklift.jpg',
  'order-pickers': '/images/products/warehouse-forklift.jpg',
};
---

<BaseLayout title="Products — Forklift Range" description="MLIFT complete forklift product line: electric, diesel, LPG, heavy-duty, reach trucks, pallet trucks, stackers, order pickers. 40+ models for every application.">

<section class="page-header">
  <div class="container">
    <div class="breadcrumb"><a href="/">Home</a> / <span>Products</span></div>
    <h1>Our Products</h1>
    <p style="opacity:0.8;font-size:1.05rem;margin-top:4px">{forkliftCategories.length} product categories — 40+ forklift models for every material handling application</p>
  </div>
</section>

<!-- ===== PRODUCT CATEGORIES ===== -->
<section class="section">
  <div class="container">
    <div class="sec-hdr">
      <span class="sec-tag">Complete Range</span>
      <h2>Find Your Forklift</h2>
      <p>From compact electric pallet trucks to 25-ton heavy-duty diesel forklifts, MLIFT covers every application.</p>
    </div>

    {forkliftCategories.map((cat, ci) => (
      <div id={cat.id} style={`margin-bottom:${ci < forkliftCategories.length - 1 ? 'var(--space-8)' : '0'}`}>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-5);align-items:start">
          <div>
            <img src={catImages[cat.id] || '/images/products/ic-forklift.jpg'} alt={cat.name} style="width:100%;border-radius:var(--radius-md);box-shadow:var(--shadow-sm);margin-bottom:var(--space-3);aspect-ratio:4/3;object-fit:cover" />
            <div style="display:flex;align-items:center;gap:var(--space-2);margin-bottom:var(--space-2)">
              <span style="font-size:2.2rem">{cat.icon}</span>
              <div>
                <h3 style="font-size:1.5rem;font-weight:var(--fw-extrabold);text-transform:uppercase;margin:0;color:var(--c-text)">{cat.name}</h3>
                <div style="font-size:0.85rem;color:var(--c-red)">{cat.nameZh}</div>
              </div>
            </div>
            <p style="font-size:0.93rem;line-height:1.7;color:var(--c-text-secondary)">{cat.description}</p>
          </div>
          <div>
            <div style="font-size:0.8rem;text-transform:uppercase;letter-spacing:2px;color:var(--c-red);font-weight:var(--fw-bold);margin-bottom:var(--space-2)">Available Models</div>
            {cat.models.map(m => (
              <a href={`/products/${cat.id}/${m.id}`} style="text-decoration:none;display:block;background:var(--c-bg-alt);padding:var(--space-2) var(--space-3);border-radius:6px;margin-bottom:var(--space-1);border:1px solid var(--c-border);transition:all 0.25s;color:var(--c-text)">
                <div style="display:flex;justify-content:space-between;align-items:center">
                  <div>
                    <div style="font-weight:var(--fw-bold);font-size:0.95rem">{m.name}</div>
                    <div style="font-size:0.78rem;color:var(--c-text-muted)">{m.tagline}</div>
                  </div>
                  <div style="color:var(--c-red);font-size:0.8rem;font-weight:var(--fw-bold)">{m.capacity}</div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- ===== CTA ===== -->
<section class="cta-section">
  <div class="container">
    <h2>Not Sure Which Model?</h2>
    <p>Our team can help you select the right forklift for your specific application, capacity requirements, and operating environment.</p>
    <a href="/contact" class="hero-cta">Request a Consultation</a>
  </div>
</section>

</BaseLayout>
