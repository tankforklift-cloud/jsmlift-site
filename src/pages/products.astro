---
import BaseLayout from '../layouts/BaseLayout.astro';
import { m16 } from '../data/m16';
---

<BaseLayout title="Products" description="MLIFT M16 round bale wrapper — our flagship product. Transport, wrap, and stack round bales with one compact machine.">

<section class="page-header">
  <div class="container">
    <div class="breadcrumb"><a href="/">Home</a> / <span>Products</span></div>
    <h1>Our Products</h1>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="sec-hdr">
      <span class="sec-tag">Agricultural Machinery</span>
      <h2>Round Bale Wrapper</h2>
      <p>The MLIFT M16 — engineered for farmers who demand reliability without the premium price tag.</p>
    </div>

    <div style="max-width:600px;margin:0 auto">
      <div class="product-card">
        <div class="pc-img">
          <img src="/images/m16/m16/m16-main.jpg" alt="MLIFT M16 Round Bale Wrapper" />
        </div>
        <div class="pc-body">
          <h3>MLIFT M16</h3>
          <div class="pc-model">Round Bale Wrapper</div>
          <p>{m16.description}</p>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:var(--space-2) 0">
            {m16.highlights.map(h => (
              <div style="font-size:0.82rem;color:var(--c-text-muted)">
                <strong style="color:var(--c-red)">{h.value}</strong> {h.label}
              </div>
            ))}
          </div>
          <a href="/m16" class="pc-btn">View Full Specifications</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="cta-section">
  <div class="container">
    <h2>Ready to Order?</h2>
    <p>Get in touch for pricing, availability, and custom configuration options for the MLIFT M16.</p>
    <a href="/contact" class="hero-cta">Request a Quote</a>
  </div>
</section>

</BaseLayout>
