---
import BaseLayout from '../layouts/BaseLayout.astro';
import { excavators } from '../data/excavators';
---

<BaseLayout title="Mini Excavators" description="MLIFT Mini Excavators — HS12-6, HS18, HS20A, HS45. Compact hydraulic excavators with Kubota & Yanmar engines. Worldwide shipping.">
  <div class="page-header">
    <div class="container">
      <p class="breadcrumb"><a href="/">Home</a> &rsaquo; Mini Excavators</p>
      <h1>Mini Excavators</h1>
    </div>
  </div>

  <section class="section">
    <div class="container">
      {excavators.map(ex => (
        <article class="ex-row">
          <a href={`/product/${ex.slug}`} class="ex-row-img">
            <img src={ex.images[0]} alt={ex.name} loading="lazy" />
          </a>
          <div class="ex-row-body">
            {ex.badge && <span class="badge badge-yellow">{ex.badge}</span>}
            <h3>{ex.name}</h3>
            <p class="model">Model: {ex.model}</p>
            <p class="desc">{ex.description.slice(0, 200)}&hellip;</p>
            <div class="ex-tags">
              <span>{ex.weight}</span>
              <span>{ex.engine}</span>
              <span>{ex.power}</span>
              <span>{ex.bucket}</span>
            </div>
            <a href={`/product/${ex.slug}`} class="btn btn-yellow">View Details &rarr;</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <h2>Find Your Excavator</h2>
      <p>Not sure which model fits your needs? Contact us for a personalized recommendation.</p>
      <a href="/contact" class="btn btn-yellow btn-lg">Contact Us &rarr;</a>
    </div>
  </section>
</BaseLayout>
