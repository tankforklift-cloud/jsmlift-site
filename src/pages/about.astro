---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About MLIFT" description="MLIFT is a professional forklift manufacturer based in Jingjiang, China. ISO 9001 & CE certified, exporting to 50+ countries with comprehensive after-sales support.">

<section class="page-header">
  <div class="container">
    <div class="breadcrumb"><a href="/">Home</a> / <span>About Us</span></div>
    <h1>About MLIFT</h1>
  </div>
</section>

<!-- ===== ABOUT INTRO ===== -->
<section class="section">
  <div class="container">
    <div class="abt-grid">
      <div style="background:var(--c-dark-2);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;min-height:360px;border:1px solid var(--c-dark-4)">
        <div style="text-align:center;padding:var(--space-5)">
          <div style="font-size:6rem;margin-bottom:var(--space-2)">🏗️</div>
          <div style="font-size:1.5rem;font-weight:var(--fw-extrabold);color:var(--c-red);text-transform:uppercase">MLIFT</div>
          <div style="font-size:0.85rem;color:var(--c-text-muted);margin-top:var(--space-1)">Lifting the Future</div>
        </div>
      </div>
      <div class="abt-text">
        <h2>Engineering That Moves the World</h2>
        <p>
          JINGJIANG MLIFT MACHINERY CO.,LTD is a professional forklift manufacturer, delivering a complete range 
          of material handling equipment to businesses worldwide. From compact electric warehouse trucks to 
          25-ton heavy-duty diesel forklifts, <strong>MLIFT</strong> provides reliable, cost-effective solutions 
          for every application.
        </p>
        <p>
          Based in Jingjiang, Jiangsu, China, our manufacturing facility combines precision engineering with 
          rigorous quality control. ISO 9001 and CE certified, every forklift undergoes 100+ inspection points 
          before delivery. We export to 50+ countries with comprehensive spare parts availability, technical 
          support, and dealer network coverage.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ===== MISSION / VISION / HISTORY ===== -->
<section class="section section-dark">
  <div class="container">
    <div class="sec-hdr">
      <h2>Who We Are</h2>
      <p>Driven by innovation, built on quality. MLIFT's commitment to material handling excellence.</p>
    </div>
    <div class="tabs-wrap">
      <div class="tabs-nav" id="tabsNav">
        <button class="tab-btn active" data-tab="mission">Our Mission</button>
        <button class="tab-btn" data-tab="vision">Our Vision</button>
        <button class="tab-btn" data-tab="history">Our History</button>
      </div>
      <div class="tab-panel active" id="mission">
        <h3>Delivering Reliable Material Handling Solutions</h3>
        <p>Our mission is to provide professional-grade forklift equipment at competitive prices. Every MLIFT forklift is engineered to perform reliably in real-world conditions — from the busy ports of Southeast Asia to the demanding warehouses of the Middle East. We believe every business deserves quality material handling equipment that works as hard as they do.</p>
      </div>
      <div class="tab-panel" id="vision">
        <h3>Global Reach, Local Support</h3>
        <p>We envision MLIFT as a globally recognized brand in material handling — trusted by businesses on every continent. Through continuous engineering refinement, strategic partnerships, and unwavering customer commitment, we aim to become the preferred choice for forklift solutions worldwide.</p>
      </div>
      <div class="tab-panel" id="history">
        <h3>Rooted in Manufacturing Excellence</h3>
        <p>JINGJIANG MLIFT MACHINERY CO.,LTD was founded with a clear purpose: to build industrial equipment that meets international quality standards at competitive prices. Our team brings decades of manufacturing experience, and every forklift represents the culmination of rigorous engineering, testing, and customer-driven refinement.</p>
      </div>
    </div>
  </div>
</section>

<!-- ===== CORE VALUES ===== -->
<section class="section">
  <div class="container">
    <div class="sec-hdr">
      <span class="sec-tag">What We Stand For</span>
      <h2>Our Core Values</h2>
      <p>The principles that guide every MLIFT forklift we manufacture.</p>
    </div>
    <div class="value-grid">
      <div class="value-card">
        <div class="v-icon">&#x1F527;</div>
        <h4>Engineering Quality</h4>
        <p>Every component is selected and tested for long-term reliability in demanding industrial environments.</p>
      </div>
      <div class="value-card">
        <div class="v-icon">&#x1F4B0;</div>
        <h4>Fair Pricing</h4>
        <p>We eliminate unnecessary overhead to deliver professional-grade forklifts at competitive prices.</p>
      </div>
      <div class="value-card">
        <div class="v-icon">&#x1F30D;</div>
        <h4>Global Mindset</h4>
        <p>Built to meet international standards. Shipped worldwide with full documentation and local support.</p>
      </div>
      <div class="value-card">
        <div class="v-icon">&#x1F91D;</div>
        <h4>Customer Partnership</h4>
        <p>We work closely with every customer to ensure the right forklift configuration for their operation.</p>
      </div>
    </div>
  </div>
</section>

<!-- ===== STATS ===== -->
<section class="section section-dark">
  <div class="container">
    <div class="stats-row">
      <div class="stat-item">
        <div class="stat-num">15+</div>
        <div class="stat-label">Years Experience</div>
      </div>
      <div class="stat-item">
        <div class="stat-num">50+</div>
        <div class="stat-label">Countries Served</div>
      </div>
      <div class="stat-item">
        <div class="stat-num">40+</div>
        <div class="stat-label">Forklift Models</div>
      </div>
      <div class="stat-item">
        <div class="stat-num">100%</div>
        <div class="stat-label">Factory Tested</div>
      </div>
    </div>
  </div>
</section>

<!-- ===== CTA ===== -->
<section class="cta-section">
  <div class="container">
    <h2>Work With MLIFT</h2>
    <p>Whether you're a warehouse operator, fleet manager, or equipment dealer — we'd love to hear from you. Get in touch to discuss how MLIFT can serve your material handling needs.</p>
    <a href="/contact" class="hero-cta">Contact Us</a>
  </div>
</section>

</BaseLayout>

<script is:inline>
  const tabBtns = document.querySelectorAll('.tab-btn');
  const tabPanels = document.querySelectorAll('.tab-panel');
  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = (btn as HTMLElement).dataset.tab;
      tabBtns.forEach(b => b.classList.remove('active'));
      (btn as HTMLElement).classList.add('active');
      tabPanels.forEach(p => p.classList.remove('active'));
      document.getElementById(tab!)?.classList.add('active');
    });
  });
</script>
