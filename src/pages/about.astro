---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About Us" description="MLIFT — Professional manufacturer of mini excavators and OEM forklift parts supplier based in China.">
  <div class="page-header">
    <div class="container">
      <p class="breadcrumb"><a href="/">Home</a> &rsaquo; About Us</p>
      <h1>About MLIFT</h1>
    </div>
  </div>

  <section class="about-intro">
    <div class="container">
      <div class="about-grid">
        <div>
          <img src="/images/hero/hs-factory.jpg" alt="MLIFT Factory" loading="lazy" />
        </div>
        <div class="about-text">
          <h2>Your Trusted Machinery Partner</h2>
          <p>MLIFT is a professional manufacturer and exporter of mini excavators and OEM forklift parts based in China. With years of industry experience, we provide high-quality construction machinery and replacement parts to customers worldwide.</p>
          <p>Our mini excavator lineup ranges from 1.2-ton to 4.2-ton machines, powered by reliable Kubota and Yanmar engines. All models feature advanced hydraulic systems from industry-leading suppliers like KYB Japan and Eaton.</p>
          <p>For forklift parts, we stock a comprehensive range of OEM-compatible components covering 13 categories — from engine parts and hydraulic systems to brake assemblies and electrical components.</p>

          <div class="about-stats">
            <div class="stat-item">
              <div class="stat-num">4</div>
              <div class="stat-label">Excavator Models</div>
            </div>
            <div class="stat-item">
              <div class="stat-num">70+</div>
              <div class="stat-label">Parts Products</div>
            </div>
            <div class="stat-item">
              <div class="stat-num">13</div>
              <div class="stat-label">Part Categories</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-dark">
    <div class="container">
      <h2>Ready to Work Together?</h2>
      <p>Contact us today for a quote on our mini excavators, forklift parts, or any custom machinery requirements.</p>
      <a href="/contact" class="btn-yellow">Contact Us <i class="fas fa-envelope"></i></a>
    </div>
  </section>
</BaseLayout>
