---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { excavators } from '../../data/excavators';

export function getStaticPaths() {
  return excavators.map(ex => ({ params: { slug: ex.slug } }));
}

const { slug } = Astro.params;
const ex = excavators.find(e => e.slug === slug);

if (!ex) {
  return Astro.redirect('/excavators');
}
---

<BaseLayout title={ex.name} description={ex.description}>
  <div class="page-header">
    <div class="container">
      <p class="breadcrumb"><a href="/">Home</a> &rsaquo; <a href="/excavators">Mini Excavators</a> &rsaquo; {ex.model}</p>
      <h1>{ex.name}</h1>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="detail-grid">
        <!-- Gallery -->
        <div>
          <div class="gallery-main" id="galleryMain">
            <img src={ex.images[0]} alt={ex.name} id="mainImage" />
          </div>
          <div class="gallery-thumbs" id="galleryThumbs">
            {ex.images.map((img, i) => (
              <button class:list={[{ active: i === 0 }]} data-img={img}>
                <img src={img} alt={`${ex.name} ${i + 1}`} loading="lazy" />
              </button>
            ))}
          </div>
        </div>

        <!-- Info -->
        <div class="detail-info">
          {ex.badge && <span class="d-badge">{ex.badge}</span>}
          <h1>{ex.name}</h1>
          <p class="d-model">Model: {ex.model}</p>
          <p class="d-desc">{ex.description}</p>

          <!-- Specs Table -->
          <table class="specs-table">
            <tbody>
              {Object.entries(ex.specs).map(([key, val]) => (
                <tr><th>{key}</th><td>{val}</td></tr>
              ))}
            </tbody>
          </table>

          <!-- Features -->
          <h3 class="feat-title">Key Features</h3>
          <ul class="feat-grid">
            {ex.features.map(f => <li>{f}</li>)}
          </ul>

          <a href={`/contact?interest=excavator&model=${ex.model}`} class="btn btn-yellow btn-lg">Send Inquiry &rarr;</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll('.gallery-thumbs button').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.gallery-thumbs button').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const mainImage = document.getElementById('mainImage') as HTMLImageElement;
      if (mainImage) mainImage.src = btn.dataset.img || '';
    });
  });
</script>
