---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { excavators } from '../../data/excavators';

export function getStaticPaths() {
  return excavators.map(e => ({ params: { slug: e.slug } }));
}

const { slug } = Astro.params;
const excavator = excavators.find(e => e.slug === slug);

if (!excavator) {
  return Astro.redirect('/excavators');
}
---

<BaseLayout title={excavator.name} description={excavator.description.slice(0, 160)}>
  <div class="page-header">
    <div class="container">
      <p class="breadcrumb">
        <a href="/">Home</a> &rsaquo; <a href="/excavators">Mini Excavators</a> &rsaquo; {excavator.name}
      </p>
      <h1>{excavator.name}</h1>
    </div>
  </div>

  <section class="product-detail">
    <div class="container">
      <!-- Gallery + Info -->
      <div class="product-detail-layout">
        <div class="product-gallery">
          <div class="main-image">
            <img id="mainImage" src={excavator.images[0]} alt={excavator.name} />
          </div>
          {excavator.images.length > 1 && (
            <div class="thumb-strip">
              {excavator.images.map((img, i) => (
                <button class={i === 0 ? 'active' : ''} onclick={`document.getElementById('mainImage').src='${img}'`}>
                  <img src={img} alt={`${excavator.name} view ${i + 1}`} loading="lazy" />
                </button>
              ))}
            </div>
          )}
        </div>

        <div class="product-info">
          {excavator.badge && <span class={`prod-badge ec-badge ${excavator.badge.toLowerCase()}`}>{excavator.badge}</span>}
          <h1>{excavator.name}</h1>
          <p class="prod-model">Model: {excavator.model}</p>
          <p class="prod-desc">{excavator.description}</p>

          <table class="specs-table">
            <tbody>
              {Object.entries(excavator.specs).map(([key, val]) => (
                <tr>
                  <th>{key}</th>
                  <td>{val}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <div class="features-list">
            <h3>Key Features</h3>
            <ul>
              {excavator.features.map(f => <li>{f}</li>)}
            </ul>
          </div>

          <a href="/contact" class="hero-cta" style="display:inline-flex;">
            Send Inquiry <i class="fas fa-envelope"></i>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Gallery thumbnail switching
  document.querySelectorAll('.thumb-strip button').forEach(btn => {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.thumb-strip button').forEach(b => b.classList.remove('active'));
      this.classList.add('active');
    });
  });
</script>
