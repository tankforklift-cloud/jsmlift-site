---
import BaseLayout from '../layouts/BaseLayout.astro';
import { m16 } from '../data/m16';
---

<BaseLayout title="MLIFT M16 — Full Specifications" description="Complete technical specifications for the MLIFT M16 round bale wrapper. Dimensions, hydraulics, wrapping system, options, and more.">

<section class="page-header">
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Home</a> / <span>{m16.name}</span>
    </div>
    <h1>{m16.name}</h1>
    <p style="opacity:0.8;font-size:1.05rem;margin-top:4px">{m16.tagline}</p>
  </div>
</section>

<!-- ===== PRODUCT DETAIL ===== -->
<section class="section">
  <div class="container">
    <div class="detail-grid">
      <div>
        <div class="gallery-main">
          <img src={`/images/m16/m16/${m16.gallery[0].src}`} alt={m16.gallery[0].alt} id="mainImg" />
        </div>
        <div class="gallery-thumbs">
          {m16.gallery.map((img, i) => (
            <button class={i === 0 ? 'active' : ''} onclick={`document.getElementById('mainImg').src='/images/m16/m16/${img.src}';document.getElementById('mainImg').alt='${img.alt}';document.querySelectorAll('.gallery-thumbs button').forEach(b=>b.classList.remove('active'));event.currentTarget.classList.add('active')`}>
              <img src={`/images/m16/m16/${img.src}`} alt={img.alt} loading="lazy" />
            </button>
          ))}
        </div>
      </div>
      <div class="detail-info">
        <span class="d-badge">NEW</span>
        <h1>{m16.name}</h1>
        <div class="d-model">{m16.tagline}</div>
        <p class="d-desc">{m16.description}</p>
        <div class="d-highlights">
          {m16.highlights.map(h => (
            <div class="d-highlight">
              <div class="dh-val">{h.value}</div>
              <div class="dh-lbl">{h.label}</div>
            </div>
          ))}
        </div>
        <a href="/contact" class="btn-submit">Request a Quote</a>
      </div>
    </div>
  </div>
</section>

<!-- ===== FEATURES ===== -->
<section class="section section-dark">
  <div class="container">
    <div class="sec-hdr">
      <span class="sec-tag">Key Features</span>
      <h2>What Makes the M16</h2>
      <p>Every detail engineered for reliability and performance.</p>
    </div>
    {
      m16.features.map((feat, i) => (
        <div class="feat-card">
          <div class="feat-card-img">
            {feat.image ? <img src={`/images/m16/m16/${feat.image}`} alt={feat.title} loading={i > 1 ? 'lazy' : 'eager'} /> : <div style="width:100%;height:100%;background:var(--c-dark-4);display:flex;align-items:center;justify-content:center;color:var(--c-red);font-size:2rem;font-weight:700">{feat.title.charAt(0)}</div>}
          </div>
          <div class="feat-card-text">
            <h3>{feat.title}</h3>
            <p>{feat.desc}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<!-- ===== FULL SPECIFICATIONS ===== -->
<section class="section">
  <div class="container" style="max-width:900px">
    <div class="sec-hdr">
      <span class="sec-tag">Technical Data</span>
      <h2>Full Specifications</h2>
      <p>Complete technical specifications for the MLIFT M16 round bale wrapper.</p>
    </div>
    {
      m16.specs.map(group => (
        <div class="specs-group">
          <h3 class="specs-group-title">{group.group}</h3>
          <table class="specs-table">
            <tbody>
              {group.items.map(item => (
                <tr>
                  <th>{item.label}</th>
                  <td>{item.value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ))
    }
  </div>
</section>

<!-- ===== OPTIONS ===== -->
<section class="section section-dark">
  <div class="container" style="max-width:900px">
    <div class="sec-hdr">
      <span class="sec-tag">Customize</span>
      <h2>Optional Equipment</h2>
      <p>Configure the M16 to match your exact workflow.</p>
    </div>
    <ul class="opts-list">
      {m16.options.map(opt => <li>{opt}</li>)}
    </ul>
  </div>
</section>

<!-- ===== CTA ===== -->
<section class="cta-section">
  <div class="container">
    <h2>Interested in the M16?</h2>
    <p>Contact us for pricing, availability, and custom configuration options. We ship worldwide.</p>
    <a href="/contact" class="hero-cta">Get in Touch</a>
  </div>
</section>

</BaseLayout>
