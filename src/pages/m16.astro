---
import BaseLayout from '../layouts/BaseLayout.astro';
import { m16 } from '../data/m16';
---

<BaseLayout title="MLIFT M16 — Full Specifications" description="Complete technical specifications for the MLIFT M16 round bale wrapper. Dimensions, hydraulics, wrapping system, options, and more.">

<!-- ===== PAGE HEADER ===== -->
<section class="page-header">
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Home</a> / <span>MLIFT M16</span>
    </div>
    <h1>{m16.name}</h1>
    <p style="opacity:0.8;font-size:1.05rem;margin-top:4px">{m16.tagline}</p>
  </div>
</section>

<!-- ===== PRODUCT HERO ===== -->
<section class="section">
  <div class="container">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-5);align-items:start">
      <!-- Gallery -->
      <div>
        <div class="gallery-main" id="galleryMain">
          <img src={`/images/m16/${m16.gallery[0].src}`} alt={m16.gallery[0].alt} id="mainImg" />
        </div>
        <div class="gallery-thumbs">
          {m16.gallery.map((img, i) => (
            <button class={i === 0 ? 'active' : ''} onclick={`document.getElementById('mainImg').src='/images/m16/${img.src}';document.getElementById('mainImg').alt='${img.alt}';document.querySelectorAll('.gallery-thumbs button').forEach(b=>b.classList.remove('active'));event.currentTarget.classList.add('active')`}>
              <img src={`/images/m16/${img.src}`} alt={img.alt} loading="lazy" />
            </button>
          ))}
        </div>
      </div>
      <!-- Info -->
      <div>
        <span class="d-badge">NEW</span>
        <h1 style="font-size:2rem;font-weight:var(--fw-extrabold);margin-bottom:4px;letter-spacing:-0.3px">{m16.name}</h1>
        <p style="font-size:0.95rem;color:var(--c-text-muted);margin-bottom:var(--space-2)">{m16.tagline}</p>
        <p style="font-size:0.92rem;line-height:1.8;color:var(--c-text-muted);margin-bottom:var(--space-3)">{m16.description}</p>

        <!-- Quick Specs -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-1);margin-bottom:var(--space-3)">
          {m16.highlights.map(h => (
            <div style="padding:10px 14px;background:var(--c-gray-100)">
              <div style="font-size:0.7rem;font-weight:var(--fw-bold);text-transform:uppercase;letter-spacing:0.5px;color:var(--c-brown);margin-bottom:2px">{h.label}</div>
              <div style="font-size:0.95rem;font-weight:var(--fw-bold)">{h.value}</div>
            </div>
          ))}
        </div>

        <a href="/contact" class="btn btn-gold btn-lg">Request a Quote →</a>
      </div>
    </div>
  </div>
</section>

<!-- ===== FEATURES ===== -->
<section class="section section-gray">
  <div class="container">
    <div class="sec-hdr">
      <div class="accent-bar"></div>
      <h2>Key Features</h2>
      <p>What makes the M16 the right choice for your operation.</p>
    </div>
    {
      m16.features.map((feat, i) => (
        <div class="feat-card">
          <div class="feat-card-img">
            {feat.image ? <img src={`/images/m16/${feat.image}`} alt={feat.title} loading={i > 1 ? 'lazy' : 'eager'} /> : <div style="width:100%;height:100%;background:var(--c-brown);display:flex;align-items:center;justify-content:center;color:white;font-size:1.2rem;font-weight:700">{feat.title.charAt(0)}</div>}
          </div>
          <div class="feat-card-text">
            <h3>{feat.title}</h3>
            <p>{feat.desc}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<!-- ===== FULL SPECIFICATIONS ===== -->
<section class="section" id="full-specs">
  <div class="container" style="max-width:900px">
    <div class="sec-hdr">
      <div class="accent-bar"></div>
      <h2>Technical Specifications</h2>
      <p>Complete specifications for the MLIFT M16 round bale wrapper.</p>
    </div>
    {
      m16.specs.map(group => (
        <div class="specs-group">
          <h3 class="specs-group-title">{group.group}</h3>
          <table class="specs-table">
            <tbody>
              {group.items.map(item => (
                <tr>
                  <th>{item.label}</th>
                  <td>{item.value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ))
    }
  </div>
</section>

<!-- ===== OPTIONS ===== -->
<section class="section section-gray">
  <div class="container" style="max-width:900px">
    <div class="sec-hdr">
      <div class="accent-bar"></div>
      <h2>Optional Equipment</h2>
      <p>Configure the M16 to match your exact workflow.</p>
    </div>
    <ul class="opts-list">
      {m16.options.map(opt => <li>{opt}</li>)}
    </ul>
  </div>
</section>

<!-- ===== CTA ===== -->
<section class="cta-section">
  <div class="container">
    <h2>Interested in the M16?</h2>
    <p>Contact us for pricing, availability, and custom configuration options. We ship worldwide.</p>
    <a href="/contact" class="btn btn-gold btn-lg">Get in Touch →</a>
  </div>
</section>

</BaseLayout>
