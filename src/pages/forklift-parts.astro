---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories, products } from '../data/products';
---

<BaseLayout title="Forklift Parts" description="MLIFT Forklift Parts — OEM quality replacement parts. 13 categories, 70+ products. Air filters, brake systems, hydraulic parts & more. Worldwide shipping.">
  <div class="page-header">
    <div class="container">
      <p class="breadcrumb"><a href="/">Home</a> &rsaquo; Forklift Parts</p>
      <h1>Forklift Parts</h1>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="parts-layout">
        <aside class="parts-sidebar">
          <h3>Categories</h3>
          <nav class="cat-nav">
            {categories.map(cat => (
              <a href={`#${cat.id}`}>
                <span class="cat-thumb"><img src={cat.image} alt={cat.name} loading="lazy" /></span>
                {cat.name}
              </a>
            ))}
          </nav>
        </aside>

        <div class="parts-main">
          {categories.map(cat => {
            const catProducts = products.filter(p => p.category === cat.id);
            return (
              <div id={cat.id} style="margin-bottom: var(--space-5);">
                <h2>
                  <img src={cat.image} alt={cat.name} loading="lazy" />
                  {cat.name}
                </h2>
                <div class="parts-grid">
                  {catProducts.map(prod => (
                    <div class="part-card">
                      <div class="p-img">
                        <img src={prod.image} alt={prod.name} loading="lazy" />
                      </div>
                      <div class="p-body">
                        <h4>{prod.name}</h4>
                        <p class="p-code">ML#: {prod.id}</p>
                        <div class="p-specs">
                          {prod.specs.map((s: string) => <div>{s}</div>)}
                        </div>
                        <a href="/contact" class="p-link">Inquire Now</a>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
