---
const currentPath = Astro.url?.pathname || '/';
const isActive = (path: string) => currentPath === path || (path !== '/' && currentPath.startsWith(path));
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="header-logo">
      <img src="/logo.svg" alt="MLIFT — Tough by design" width="200" height="50" />
    </a>

    <button class="mobile-toggle" id="mobileToggle" aria-label="Menu">☰</button>

    <nav class="main-nav" id="mainNav">
      <a href="/" class:list={['', { active: isActive('/') && currentPath === '/' }]}>Home</a>
      <a href="/m16" class:list={['', { active: isActive('/m16') }]}>M16</a>
      <a href="/about" class:list={['', { active: isActive('/about') }]}>About</a>
      <a href="/contact" class:list={['', { active: isActive('/contact') }]}>Contact</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobileToggle');
  const nav = document.getElementById('mainNav');
  toggle?.addEventListener('click', () => nav?.classList.toggle('open'));
</script>
