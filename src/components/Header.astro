---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

function isActive(path: string) {
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
}
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="header-logo">
      <img src="/logo.png" alt="MLIFT" />
      <span>MLIFT</span>
    </a>

    <button class="mobile-toggle" id="mobileToggle" aria-label="Menu">
      <i class="fas fa-bars"></i>
    </button>

    <nav class="main-nav" id="mainNav">
      <a href="/" class={isActive('/') && currentPath.length <= 2 ? 'active' : ''}>Home</a>
      <a href="/excavators" class={isActive('/excavators') || isActive('/product/') ? 'active' : ''}>Mini Excavators</a>
      <a href="/forklift-parts" class={isActive('/forklift-parts') ? 'active' : ''}>Forklift Parts</a>
      <a href="/about" class={isActive('/about') ? 'active' : ''}>About Us</a>
      <a href="/contact" class={isActive('/contact') ? 'active' : ''}>Contact</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobileToggle');
  const nav = document.getElementById('mainNav');
  toggle?.addEventListener('click', () => {
    nav?.classList.toggle('open');
  });
</script>
