---
export interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

function isActive(path: string) {
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
}
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="header-logo">
      MLIFT
    </a>
    <button class="mobile-toggle" id="mobileToggle" aria-label="Menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
    <nav class="main-nav" id="mainNav">
      <a href="/" class:list={[{ active: isActive('/') && currentPath === '/' }]}>Home</a>
      <a href="/excavators" class:list={[{ active: isActive('/excavators') || isActive('/product/') }]}>Mini Excavators</a>
      <a href="/forklift-parts" class:list={[{ active: isActive('/forklift-parts') }]}>Forklift Parts</a>
      <a href="/about" class:list={[{ active: isActive('/about') }]}>About Us</a>
      <a href="/contact" class:list={[{ active: isActive('/contact') }]}>Contact</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobileToggle');
  const nav = document.getElementById('mainNav');
  toggle?.addEventListener('click', () => {
    nav?.classList.toggle('open');
  });
</script>
