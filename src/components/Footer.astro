    aboutUsText: 'JINGJIANG MLIFT MACHINERY CO.,LTD is committed to delivering high-performance material handling equipment to businesses worldwide. ISO 9001 &amp; CE certified.',
    companyInfo: 'Company Info',
    quickContact: 'Quick Contact',
    copyright: 'All rights reserved.',
  },
  es: {
    about: 'Fabricante profesional de montacargas. Montacargas el&eacute;ctricos, di&eacute;sel, GLP y pesados &mdash; 1.5 a 25 toneladas. Con sede en Jingjiang, Jiangsu, China.',
    aboutUs: 'Sobre Nosotros',
    aboutUsText: 'JINGJIANG MLIFT MACHINERY CO.,LTD se compromete a ofrecer equipos de manipulaci&oacute;n de materiales de alto rendimiento a empresas de todo el mundo. Certificados ISO 9001 y CE.',
    companyInfo: 'Informaci&oacute;n',
    quickContact: 'Contacto R&aacute;pido',
    copyright: 'Todos los derechos reservados.',
  },
  fr: {
    about: 'Fabricant professionnel de chariots &eacute;l&eacute;vateurs. Chariots &eacute;lectriques, diesel, GPL et lourds &mdash; 1.5 &agrave; 25 tonnes. Bas&eacute; &agrave; Jingjiang, Jiangsu, Chine.',
    aboutUs: '&Agrave; propos',
    aboutUsText: 'JINGJIANG MLIFT MACHINERY CO.,LTD s&rsquo;engage &agrave; fournir des &eacute;quipements de manutention de haute performance aux entreprises du monde entier. Certifi&eacute; ISO 9001 et CE.',
    companyInfo: 'Infos Soci&eacute;t&eacute;',
    quickContact: 'Contact Rapide',
    copyright: 'Tous droits r&eacute;serv&eacute;s.',
  },
  ar: {
    about: 'شركة تصنيع رافعات شوكية محترفة. رافعات شوكية كهربائية وديزل وغاز وثقيلة &mdash; 1.5 إلى 25 طنًا. مقرها في جينغجيانغ، جيانغسو، الصين.',
    aboutUs: 'من نحن',
    aboutUsText: 'تلتزم JINGJIANG MLIFT MACHINERY CO.,LTD بتقديم معدات مناولة مواد عالية الأداء للشركات في جميع أنحاء العالم. معتمدة ISO 9001 و CE.',
    companyInfo: 'معلومات الشركة',
    quickContact: 'اتصال سريع',
    copyright: 'جميع الحقوق محفوظة.',
  },
  ru: {
    about: 'Профессиональный производитель погрузчиков. Электрические, дизельные, газовые и тяжелые погрузчики &mdash; 1.5 до 25 тонн. Базируется в Цзинцзяне, Цзянсу, Китай.',
    aboutUs: 'О нас',
    aboutUsText: 'JINGJIANG MLIFT MACHINERY CO.,LTD стремится поставлять высокопроизводительное оборудование для обработки материалов предприятиям по всему миру. Сертифицировано ISO 9001 и CE.',
    companyInfo: 'О компании',
    quickContact: 'Быстрая связь',
    copyright: 'Все права защищены.',
  },
  pt: {
    about: 'Fabricante profissional de empilhadeiras. Empilhadeiras el&eacute;tricas, diesel, GLP e pesadas &mdash; 1.5 a 25 toneladas. Sediada em Jingjiang, Jiangsu, China.',
    aboutUs: 'Sobre N&oacute;s',
