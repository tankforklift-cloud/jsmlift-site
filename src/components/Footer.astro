---
import { excavators } from '../data/excavators';
---

<footer class="site-footer">
  <div class="footer-grid">
    <div class="footer-col">
      <h4>MLIFT Machinery</h4>
      <p>Professional manufacturer of mini excavators and supplier of OEM forklift parts. Quality products, competitive pricing, worldwide shipping.</p>
    </div>
    <div class="footer-col">
      <h4>Products</h4>
      <ul>
        {excavators.map(e => (
          <li><a href={`/product/${e.slug}`}>{e.model} Mini Excavator</a></li>
        ))}
        <li><a href="/forklift-parts">Forklift Parts</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Quick Links</h4>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/excavators">Mini Excavators</a></li>
        <li><a href="/forklift-parts">Forklift Parts</a></li>
        <li><a href="/about">About Us</a></li>
        <li><a href="/contact">Contact Us</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Contact</h4>
      <p>
        <i class="fas fa-phone"></i> +86-159-9605-5825<br/>
        <i class="fas fa-envelope"></i> tan@jsmlift.com<br/>
        <i class="fab fa-whatsapp"></i> +86-159-9605-5825<br/>
        <i class="fab fa-weixin"></i> tanklift
      </p>
    </div>
  </div>
  <div class="footer-bottom">
    <p>&copy; {new Date().getFullYear()} MLIFT. All Rights Reserved. | <a href="/contact">Contact</a></p>
  </div>
</footer>
