const d = t[locale] || t.en;
const prefix = locale === defaultLocale ? '' : `/${locale}`;
---

<footer class="site-footer">
  <div class="footer-grid">
    <div>
      <h4>MLIFT</h4>
      <p>{d.about}</p>
      <div class="footer-social">
        <a href="#" aria-label="Facebook">f</a>
        <a href="#" aria-label="Instagram">in</a>
        <a href="#" aria-label="LinkedIn">in</a>
      </div>
    </div>
    <div>
      <h4>{d.aboutUs}</h4>
      <p>{d.aboutUsText}</p>
    </div>
    <div>
      <h4>{d.companyInfo}</h4>
      <ul>
        <li><a href={`${prefix}/about`}>About Us</a></li>
        <li><a href={`${prefix}/products`}>Products</a></li>
        <li><a href={`${prefix}/support`}>Support</a></li>
        <li><a href={`${prefix}/blog`}>Blog</a></li>
        <li><a href={`${prefix}/contact`}>Contact Us</a></li>
      </ul>
    </div>
    <div>
      <h4>{d.quickContact}</h4>
      <p>
        Phone: +86 152 9523 7612<br />
        Email: tan@jsmlift.com<br />
        WhatsApp: +86 152 9523 7612
      </p>
    </div>
  </div>
  <div class="footer-bottom">
    &copy; {new Date().getFullYear()} MLIFT. {d.copyright} | JINGJIANG MLIFT MACHINERY CO.,LTD
  </div>
</footer>
